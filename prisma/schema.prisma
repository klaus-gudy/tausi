// Prisma schema. The connection URL is built from the DB_* variables in
// prisma.config.ts. Tables and columns are snake_case in the database so raw
// SQL through query() reads naturally; Prisma maps them to camelCase.
//
// Tenancy: an organization is the tenant. Users are global and join
// organizations through memberships. Tables for a feature you build belong to
// one organization: give them an organizationId with onDelete: Cascade.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// Identity (global, not owned by an organization)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  name            String?
  avatarUrl       String?   @map("avatar_url")
  // Staff of the platform itself, not of any one organization.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  memberships          Membership[]        @relation("MembershipUser")
  membershipsInvited   Membership[]        @relation("MembershipInvitedBy")
  organizationsCreated Organization[]
  invitationsSent      Invitation[]        @relation("InvitationInvitedBy")
  invitationsAccepted  Invitation[]        @relation("InvitationAcceptedBy")
  authAccounts         AuthAccount[]
  sessions             Session[]
  verificationTokens   VerificationToken[]
  stockMovements       StockMovement[]     @relation("StockMovementCreatedBy")
  stockHeld            StockMovement[]     @relation("StockMovementSalesperson")
  stockReceipts        StockReceipt[]
  dispatchesSent       Dispatch[]          @relation("DispatchDispatchedBy")
  dispatchesReceived   Dispatch[]          @relation("DispatchReceivedBy")
  dispatchesAssigned   Dispatch[]          @relation("DispatchSalesperson")
  sales                Sale[]
  paymentsCollected    Payment[]
  productsCreated      Product[]           @relation("ProductCreatedBy")
  productsUpdated      Product[]           @relation("ProductUpdatedBy")

  @@map("users")
}

// How a user signs in. One row per method: "password" (providerAccountId is
// the user id) or an OAuth provider such as "google" (their account id).
model AuthAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  // scrypt hash, only for the "password" provider.
  passwordHash      String?  @map("password_hash")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

// A signed-in browser. The cookie holds a random token; only its SHA-256
// hash is stored, so a leaked table can't be used to sign in.
model Session {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash            String   @unique @map("token_hash")
  userId               String   @map("user_id") @db.Uuid
  // The organization the user is working in; every tenant query scopes to it.
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  expiresAt            DateTime @map("expires_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("sessions")
}

enum VerificationPurpose {
  verify_email
  reset_password
  magic_link

  @@map("verification_purpose")
}

// Single-use tokens sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose    VerificationPurpose
  email      String              @db.Citext
  userId     String?             @map("user_id") @db.Uuid
  tokenHash  String              @unique @map("token_hash")
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  // Unique among live organizations, ignoring case: "Acme" and "acme" clash.
  name        String    @db.Citext
  logoUrl     String?   @map("logo_url")
  // The workspace every user gets at sign-up; it has a single member.
  isPersonal  Boolean   @default(false) @map("is_personal")
  settings    Json      @default("{}")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  roles          Role[]
  memberships    Membership[]
  invitations    Invitation[]
  sessions       Session[]
  products       Product[]
  superDealers   SuperDealer[]
  warehouses     Warehouse[]
  stockMovements StockMovement[]
  stockReceipts  StockReceipt[]
  dispatches     Dispatch[]
  sales          Sale[]
  payments       Payment[]
  zones          Zone[]
  regions        Region[]
  districts      District[]

  @@unique([name], map: "organizations_name_key", where: raw("deleted_at IS NULL"))
  @@map("organizations")
}

// What a role may do, as dotted keys: "members.invite", "billing.manage".
// Features you build add their own keys ("projects.create") in a migration.
model Permission {
  key         String  @id
  description String?

  roles RolePermission[]

  @@map("permissions")
}

// The one system role, owner, has no organization and is shared by all: it
// can do everything and goes to whoever creates the organization. Every other
// role is the organization's own. A migration adding permission keys grants
// them to owner.
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  // NULLs are distinct in the unique above, so system role keys need their own.
  @@unique([key], map: "roles_system_key_key", where: raw("organization_id IS NULL"))
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

enum MembershipStatus {
  active
  suspended

  @@map("membership_status")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(active)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  // NoAction, not Restrict: checked at the end of the statement, so deleting an
  // organization can cascade through its custom roles and memberships together.
  role         Role         @relation(fields: [roleId], references: [id], onDelete: NoAction)
  invitedBy    User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.Citext
  roleId         String           @map("role_id") @db.Uuid
  // SHA-256 of the token in the invite link; the token itself is never stored.
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: NoAction)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  // At most one open invitation per address per organization.
  @@unique([organizationId, email], map: "invitations_pending_email_key", where: raw("status = 'pending'"))
  @@index([email])
  @@index([roleId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

// What the organization stocks. Prices are whole amounts in the
// organization's currency. Stock on hand is not stored here: it is the sum of
// the product's stock movements.
model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // Generated from the name when the product is added, e.g. "SUNFLOWER-OIL";
  // unique among the organization's products, ignoring case.
  code           String    @db.Citext
  name           String
  // Kept for later; not shown or edited in the app yet.
  description    String?
  // Pack size as written on the product: "1L", "500g", "24 x 330ml".
  size           String?
  sellingPrice   Int       @default(0) @map("selling_price")
  // Archived products keep their history but can't be received or issued.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?           @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@unique([organizationId, code])
  @@map("products")
}

// The shops and distributors stock is issued to: where it leaves the store.
// Every field is optional, but a dealer needs a shop name or a contact name,
// and a phone or an email (checked in the database too).
model SuperDealer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // Unique among the organization's dealers, ignoring case.
  shopName       String?   @map("shop_name") @db.Citext
  contactName    String?   @map("contact_name")
  // Stored as +255754123456; see lib/dealers.ts.
  phone          String?
  email          String?   @db.Citext
  // The zone comes from the region.
  regionKey      String?   @map("region_key")
  // Must be in the region.
  districtKey    String?   @map("district_key")
  // Street, area or landmark within the district.
  address        String?
  notes          String?
  // Inactive dealers keep their history but can't be issued stock.
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Places are the organization's own, so the keys pair with organizationId.
  region         Region?         @relation(fields: [organizationId, regionKey], references: [organizationId, key], onDelete: NoAction)
  district       District?       @relation(fields: [organizationId, regionKey, districtKey], references: [organizationId, regionKey, key], onDelete: NoAction)
  stockMovements StockMovement[]
  sales          Sale[]
  payments       Payment[]

  @@unique([organizationId, shopName])
  @@index([organizationId, regionKey])
  @@map("super_dealers")
}

// Where the organization keeps its stock: the sum of the ledger rows it holds.
model Warehouse {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // Unique among the organization's warehouses, ignoring case.
  name           String    @db.Citext
  // The zone comes from the region.
  regionKey      String?   @map("region_key")
  // Must be in the region.
  districtKey    String?   @map("district_key")
  // Street, area or landmark within the district.
  address        String?
  // An estimate, in capacityUnit; see lib/warehouses.ts for the units.
  capacity       Int?
  capacityUnit   String    @default("units") @map("capacity_unit")
  // The storekeeper or manager to call.
  contactName    String?   @map("contact_name")
  // Stored as +255754123456; see lib/dealers.ts.
  phone          String?
  // Inactive warehouses are kept for the record but hidden from the main list.
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Places are the organization's own, so the keys pair with organizationId.
  region         Region?         @relation(fields: [organizationId, regionKey], references: [organizationId, key], onDelete: NoAction)
  district       District?       @relation(fields: [organizationId, regionKey, districtKey], references: [organizationId, regionKey, key], onDelete: NoAction)
  stockMovements StockMovement[]
  stockReceipts  StockReceipt[]
  dispatches     Dispatch[]

  @@unique([organizationId, name])
  @@index([organizationId, regionKey])
  @@map("warehouses")
}

enum StockMovementType {
  // In from a supplier, to a warehouse.
  received
  // Warehouse straight to a super dealer.
  issued
  // Warehouse to in transit, when a dispatch leaves.
  dispatched
  // In transit to the salesperson, when they acknowledge the dispatch.
  delivered
  // Salesperson to a super dealer, on a sale.
  distributed
  // Back up the chain: dealer to salesperson, salesperson to warehouse.
  returned
  // A correction after a count, damage, loss or transit shortage; either direction.
  adjustment
  // Cancels an earlier movement with the opposite quantity.
  reversal

  @@map("stock_movement_type")
}

// Whose stock a ledger row counts toward. The matching id is always set:
// warehouseId, dispatchId (in transit), salespersonId or superDealerId.
enum StockHolder {
  warehouse
  in_transit
  salesperson
  super_dealer

  @@map("stock_holder")
}

// The stock ledger. Rows are never edited or deleted: a mistake is undone by
// a reversal row, so the history always explains the current balance.
//
// Each row changes one holder's balance; a holder's stock is the sum of its
// rows. Moving stock writes two rows sharing a transferId, -N from one holder
// and +N to the other, so the organization's total only changes when stock is
// received or adjusted. The other ids say who else took part: the warehouse
// row of a dispatch also names the dispatch and the salesperson.
model StockMovement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  type           StockMovementType
  holder         StockHolder
  // Signed: positive adds to the holder's stock, negative removes it.
  quantity       Int
  // Cost per unit paid to the supplier, for received stock.
  unitCost       Int?              @map("unit_cost")
  // Price per unit charged to the dealer, for distributed stock.
  unitPrice      Int?              @map("unit_price")
  warehouseId    String?           @map("warehouse_id") @db.Uuid
  salespersonId  String?           @map("salesperson_id") @db.Uuid
  superDealerId  String?           @map("super_dealer_id") @db.Uuid
  // The two rows of one move.
  transferId     String?           @map("transfer_id") @db.Uuid
  receiptId      String?           @map("receipt_id") @db.Uuid
  dispatchId     String?           @map("dispatch_id") @db.Uuid
  saleId         String?           @map("sale_id") @db.Uuid
  // Issue or return number; receipts keep theirs on the receipt.
  reference      String?
  note           String?
  // The day it happened, which may be before it was recorded.
  occurredOn     DateTime          @map("occurred_on") @db.Date
  // The movement this one reverses; each can be reversed once.
  reversesId     String?           @unique @map("reverses_id") @db.Uuid
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // NoAction, not Restrict: deleting an organization cascades through its
  // dealers, warehouses, documents and movements together (see Membership.role).
  warehouse    Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: NoAction)
  salesperson  User?          @relation("StockMovementSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  superDealer  SuperDealer?   @relation(fields: [superDealerId], references: [id], onDelete: NoAction)
  receipt      StockReceipt?  @relation(fields: [receiptId], references: [id], onDelete: NoAction)
  dispatch     Dispatch?      @relation(fields: [dispatchId], references: [id], onDelete: NoAction)
  sale         Sale?          @relation(fields: [saleId], references: [id], onDelete: NoAction)
  reverses     StockMovement? @relation("StockReversal", fields: [reversesId], references: [id], onDelete: NoAction)
  reversedBy   StockMovement? @relation("StockReversal")
  createdBy    User?          @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredOn])
  @@index([organizationId, holder])
  @@index([productId])
  @@index([warehouseId])
  @@index([salespersonId])
  @@index([superDealerId])
  @@index([transferId])
  @@index([receiptId])
  @@index([dispatchId])
  @@index([saleId])
  @@map("stock_movements")
}

// A delivery from a supplier into a warehouse. Its received ledger rows are
// its lines: product, quantity and unit cost.
model StockReceipt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  supplierName   String?  @map("supplier_name")
  // Delivery note or invoice number.
  reference      String?
  note           String?
  // The day it arrived, which may be before it was recorded.
  receivedOn     DateTime @map("received_on") @db.Date
  // The storekeeper who confirmed it.
  receivedById   String?  @map("received_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: NoAction)
  receivedBy     User?           @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@index([organizationId, receivedOn])
  @@index([warehouseId])
  @@map("stock_receipts")
}

enum DispatchStatus {
  // Left the warehouse; the stock is held by the dispatch.
  in_transit
  // The salesperson acknowledged it; the stock is theirs.
  received
  // Called off before arrival; the stock went back to the warehouse.
  cancelled

  @@map("dispatch_status")
}

// A shipment from a warehouse to a salesperson. Its ledger rows say what was
// sent and what arrived; any shortfall is an adjustment out of in transit.
model Dispatch {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  // "DSP-0042"; unique among the organization's dispatches, ignoring case.
  number         String         @db.Citext
  warehouseId    String         @map("warehouse_id") @db.Uuid
  salespersonId  String         @map("salesperson_id") @db.Uuid
  // Where it is going; a salesperson may work in several regions.
  regionKey      String         @map("region_key")
  status         DispatchStatus @default(in_transit)
  // Driver, vehicle or courier.
  carrier        String?
  note           String?
  // The storekeeper who sent it.
  dispatchedById String         @map("dispatched_by_id") @db.Uuid
  dispatchedAt   DateTime       @map("dispatched_at") @db.Timestamptz
  // Set when the salesperson acknowledges it.
  receivedById   String?        @map("received_by_id") @db.Uuid
  receivedAt     DateTime?      @map("received_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: NoAction)
  salesperson    User            @relation("DispatchSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  // Places are the organization's own, so the key pairs with organizationId.
  region         Region          @relation(fields: [organizationId, regionKey], references: [organizationId, key], onDelete: NoAction)
  dispatchedBy   User            @relation("DispatchDispatchedBy", fields: [dispatchedById], references: [id], onDelete: Restrict)
  receivedBy     User?           @relation("DispatchReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([warehouseId])
  @@index([salespersonId])
  @@map("dispatches")
}

enum PaymentTerms {
  cash
  credit

  @@map("payment_terms")
}

// Stock a salesperson hands to a super dealer. Its distributed ledger rows
// are its lines; totalAmount is what the dealer owes for them.
model Sale {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  // "SAL-0042"; unique among the organization's sales, ignoring case.
  number         String       @db.Citext
  salespersonId  String       @map("salesperson_id") @db.Uuid
  superDealerId  String       @map("super_dealer_id") @db.Uuid
  terms          PaymentTerms
  totalAmount    Int          @map("total_amount")
  // When a credit sale should be paid.
  dueOn          DateTime?    @map("due_on") @db.Date
  note           String?
  soldOn         DateTime     @map("sold_on") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesperson    User            @relation(fields: [salespersonId], references: [id], onDelete: Restrict)
  superDealer    SuperDealer     @relation(fields: [superDealerId], references: [id], onDelete: NoAction)
  stockMovements StockMovement[]
  payments       Payment[]

  @@unique([organizationId, number])
  @@index([superDealerId])
  @@index([salespersonId])
  @@map("sales")
}

// Money collected from a super dealer. Like the ledger, rows are never edited:
// a mistake is corrected with a negative amount. A dealer's balance is their
// sales' totals minus their payments.
model Payment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  superDealerId  String   @map("super_dealer_id") @db.Uuid
  // The sale it pays for, when it pays for one.
  saleId         String?  @map("sale_id") @db.Uuid
  amount         Int
  // cash, mobile_money or bank (checked in the database).
  method         String
  // Receipt, transaction or slip number.
  reference      String?
  note           String?
  // The salesperson who collected it.
  collectedById  String   @map("collected_by_id") @db.Uuid
  receivedOn     DateTime @map("received_on") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  superDealer  SuperDealer  @relation(fields: [superDealerId], references: [id], onDelete: NoAction)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: NoAction)
  collectedBy  User         @relation(fields: [collectedById], references: [id], onDelete: Restrict)

  @@index([organizationId, receivedOn])
  @@index([superDealerId])
  @@index([saleId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Places (per organization)
// ---------------------------------------------------------------------------

// Each organization's sales zones, regions and districts, so dealers pick a
// place from a list instead of typing it. A new organization can start from
// Tanzania's (lib/tanzania-places.ts). Keys are slugs of the names, unique
// within the organization: "coastal", "dar-es-salaam", "kinondoni".
model Zone {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  name           String
  // Order in lists, roughly coast first and Zanzibar last.
  position       Int    @db.SmallInt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regions      Region[]

  @@id([organizationId, key])
  @@map("zones")
}

model Region {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  zoneKey        String @map("zone_key")
  name           String

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone         Zone          @relation(fields: [organizationId, zoneKey], references: [organizationId, key], onDelete: NoAction)
  districts    District[]
  superDealers SuperDealer[]
  warehouses   Warehouse[]
  dispatches   Dispatch[]

  @@id([organizationId, key])
  @@index([organizationId, zoneKey])
  @@map("regions")
}

// Unique within its region only.
model District {
  organizationId String @map("organization_id") @db.Uuid
  regionKey      String @map("region_key")
  key            String
  name           String

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  region       Region        @relation(fields: [organizationId, regionKey], references: [organizationId, key], onDelete: NoAction)
  superDealers SuperDealer[]
  warehouses   Warehouse[]

  @@id([organizationId, regionKey, key])
  @@map("districts")
}

// ---------------------------------------------------------------------------
// Rate limits
// ---------------------------------------------------------------------------

// Fixed-window counters for lib/rate-limit.ts, one row per key, e.g.
// "login:ip:203.0.113.7". Expired rows are deleted by lib/cleanup.ts.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz

  @@index([resetAt])
  @@map("rate_limits")
}
