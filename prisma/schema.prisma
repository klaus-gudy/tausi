// Prisma schema. The connection URL is built from the DB_* variables in
// prisma.config.ts. Tables and columns are snake_case in the database so raw
// SQL through query() reads naturally; Prisma maps them to camelCase.
//
// Tenancy: an organization is the tenant. Users are global and join
// organizations through memberships. Tables for a feature you build belong to
// one organization: give them an organizationId with onDelete: Cascade.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// Identity (global, not owned by an organization)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  name            String?
  avatarUrl       String?   @map("avatar_url")
  // Staff of the platform itself, not of any one organization.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  memberships          Membership[]        @relation("MembershipUser")
  membershipsInvited   Membership[]        @relation("MembershipInvitedBy")
  organizationsCreated Organization[]
  invitationsSent      Invitation[]        @relation("InvitationInvitedBy")
  invitationsAccepted  Invitation[]        @relation("InvitationAcceptedBy")
  authAccounts         AuthAccount[]
  sessions             Session[]
  verificationTokens   VerificationToken[]
  stockMovements       StockMovement[]
  productsCreated      Product[]           @relation("ProductCreatedBy")
  productsUpdated      Product[]           @relation("ProductUpdatedBy")

  @@map("users")
}

// How a user signs in. One row per method: "password" (providerAccountId is
// the user id) or an OAuth provider such as "google" (their account id).
model AuthAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  // scrypt hash, only for the "password" provider.
  passwordHash      String?  @map("password_hash")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

// A signed-in browser. The cookie holds a random token; only its SHA-256
// hash is stored, so a leaked table can't be used to sign in.
model Session {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash            String   @unique @map("token_hash")
  userId               String   @map("user_id") @db.Uuid
  // The organization the user is working in; every tenant query scopes to it.
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  expiresAt            DateTime @map("expires_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("sessions")
}

enum VerificationPurpose {
  verify_email
  reset_password
  magic_link

  @@map("verification_purpose")
}

// Single-use tokens sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose    VerificationPurpose
  email      String              @db.Citext
  userId     String?             @map("user_id") @db.Uuid
  tokenHash  String              @unique @map("token_hash")
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  // Unique among live organizations, ignoring case: "Acme" and "acme" clash.
  name        String    @db.Citext
  logoUrl     String?   @map("logo_url")
  // The workspace every user gets at sign-up; it has a single member.
  isPersonal  Boolean   @default(false) @map("is_personal")
  settings    Json      @default("{}")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  roles          Role[]
  memberships    Membership[]
  invitations    Invitation[]
  sessions       Session[]
  products       Product[]
  superDealers   SuperDealer[]
  stockMovements StockMovement[]
  zones          Zone[]
  regions        Region[]
  districts      District[]

  @@unique([name], map: "organizations_name_key", where: raw("deleted_at IS NULL"))
  @@map("organizations")
}

// What a role may do, as dotted keys: "members.invite", "billing.manage".
// Features you build add their own keys ("projects.create") in a migration.
model Permission {
  key         String  @id
  description String?

  roles RolePermission[]

  @@map("permissions")
}

// System roles (owner, admin, member, viewer) have no organization and are
// shared by all; an organization can add custom roles of its own.
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  // NULLs are distinct in the unique above, so system role keys need their own.
  @@unique([key], map: "roles_system_key_key", where: raw("organization_id IS NULL"))
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

enum MembershipStatus {
  active
  suspended

  @@map("membership_status")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(active)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  // NoAction, not Restrict: checked at the end of the statement, so deleting an
  // organization can cascade through its custom roles and memberships together.
  role         Role         @relation(fields: [roleId], references: [id], onDelete: NoAction)
  invitedBy    User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.Citext
  roleId         String           @map("role_id") @db.Uuid
  // SHA-256 of the token in the invite link; the token itself is never stored.
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: NoAction)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  // At most one open invitation per address per organization.
  @@unique([organizationId, email], map: "invitations_pending_email_key", where: raw("status = 'pending'"))
  @@index([email])
  @@index([roleId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

// What the organization stocks. Prices are whole amounts in the
// organization's currency. Stock on hand is not stored here: it is the sum of
// the product's stock movements.
model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // Generated from the name when the product is added, e.g. "SUNFLOWER-OIL";
  // unique among the organization's products, ignoring case.
  code           String    @db.Citext
  name           String
  // Kept for later; not shown or edited in the app yet.
  description    String?
  // Pack size as written on the product: "1L", "500g", "24 x 330ml".
  size           String?
  sellingPrice   Int       @default(0) @map("selling_price")
  // Archived products keep their history but can't be received or issued.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?           @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@unique([organizationId, code])
  @@map("products")
}

// The shops and distributors stock is issued to: where it leaves the store.
// Every field is optional, but a dealer needs a shop name or a contact name,
// and a phone or an email (checked in the database too).
model SuperDealer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // Unique among the organization's dealers, ignoring case.
  shopName       String?   @map("shop_name") @db.Citext
  contactName    String?   @map("contact_name")
  // Stored as +255754123456; see lib/dealers.ts.
  phone          String?
  email          String?   @db.Citext
  // The zone comes from the region.
  regionKey      String?   @map("region_key")
  // Must be in the region.
  districtKey    String?   @map("district_key")
  // Street, area or landmark within the district.
  address        String?
  notes          String?
  // Inactive dealers keep their history but can't be issued stock.
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Places are the organization's own, so the keys pair with organizationId.
  region         Region?         @relation(fields: [organizationId, regionKey], references: [organizationId, key], onDelete: NoAction)
  district       District?       @relation(fields: [organizationId, regionKey, districtKey], references: [organizationId, regionKey, key], onDelete: NoAction)
  stockMovements StockMovement[]

  @@unique([organizationId, shopName])
  @@index([organizationId, regionKey])
  @@map("super_dealers")
}

enum StockMovementType {
  // In from a supplier.
  received
  // Out to a super dealer.
  issued
  // A correction after a count, damage or loss; either direction.
  adjustment
  // Cancels an earlier movement with the opposite quantity.
  reversal

  @@map("stock_movement_type")
}

// The stock ledger. Rows are never edited or deleted: a mistake is undone by
// a reversal row, so the history always explains the current balance.
model StockMovement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  type           StockMovementType
  // Signed: positive adds stock, negative removes it.
  quantity       Int
  // Cost per unit paid to the supplier, for received stock.
  unitCost       Int?              @map("unit_cost")
  superDealerId  String?           @map("super_dealer_id") @db.Uuid
  // Supplier name for received stock.
  supplier       String?
  // Delivery note, invoice or dispatch number.
  reference      String?
  note           String?
  // The day it happened, which may be before it was recorded.
  occurredOn     DateTime          @map("occurred_on") @db.Date
  // The movement this one reverses; each can be reversed once.
  reversesId     String?           @unique @map("reverses_id") @db.Uuid
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // NoAction, not Restrict: deleting an organization cascades through its
  // dealers and movements together (see Membership.role).
  superDealer  SuperDealer?   @relation(fields: [superDealerId], references: [id], onDelete: NoAction)
  reverses     StockMovement? @relation("StockReversal", fields: [reversesId], references: [id], onDelete: NoAction)
  reversedBy   StockMovement? @relation("StockReversal")
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredOn])
  @@index([productId])
  @@index([superDealerId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Places (per organization)
// ---------------------------------------------------------------------------

// Each organization's sales zones, regions and districts, so dealers pick a
// place from a list instead of typing it. A new organization can start from
// Tanzania's (lib/tanzania-places.ts). Keys are slugs of the names, unique
// within the organization: "coastal", "dar-es-salaam", "kinondoni".
model Zone {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  name           String
  // Order in lists, roughly coast first and Zanzibar last.
  position       Int    @db.SmallInt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regions      Region[]

  @@id([organizationId, key])
  @@map("zones")
}

model Region {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  zoneKey        String @map("zone_key")
  name           String

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone         Zone          @relation(fields: [organizationId, zoneKey], references: [organizationId, key], onDelete: NoAction)
  districts    District[]
  superDealers SuperDealer[]

  @@id([organizationId, key])
  @@index([organizationId, zoneKey])
  @@map("regions")
}

// Unique within its region only.
model District {
  organizationId String @map("organization_id") @db.Uuid
  regionKey      String @map("region_key")
  key            String
  name           String

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  region       Region        @relation(fields: [organizationId, regionKey], references: [organizationId, key], onDelete: NoAction)
  superDealers SuperDealer[]

  @@id([organizationId, regionKey, key])
  @@map("districts")
}

// ---------------------------------------------------------------------------
// Rate limits
// ---------------------------------------------------------------------------

// Fixed-window counters for lib/rate-limit.ts, one row per key, e.g.
// "login:ip:203.0.113.7". Expired rows are deleted by lib/cleanup.ts.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz

  @@index([resetAt])
  @@map("rate_limits")
}
