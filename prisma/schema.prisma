// Prisma schema. The connection URL is built from the DB_* variables in
// prisma.config.ts. Tables and columns are snake_case in the database so raw
// SQL through query() reads naturally; Prisma maps them to camelCase.
//
// Tenancy: an organization is the tenant. Users are global and join
// organizations through memberships. Tables for a feature you build belong to
// one organization: give them an organizationId with onDelete: Cascade.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// Identity (global, not owned by an organization)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  name            String?
  avatarUrl       String?   @map("avatar_url")
  // Staff of the platform itself, not of any one organization.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  memberships           Membership[]        @relation("MembershipUser")
  membershipsInvited    Membership[]        @relation("MembershipInvitedBy")
  organizationsCreated  Organization[]
  invitationsSent       Invitation[]        @relation("InvitationInvitedBy")
  invitationsAccepted   Invitation[]        @relation("InvitationAcceptedBy")
  authAccounts          AuthAccount[]
  sessions              Session[]
  verificationTokens    VerificationToken[]
  stockMovements        StockMovement[]
  stockReceipts         StockReceipt[]
  transfersCreated      StockTransfer[]     @relation("TransferCreatedBy")
  transfersDispatched   StockTransfer[]     @relation("TransferDispatchedBy")
  transfersArrived      StockTransfer[]     @relation("TransferArrivedBy")
  transfersCancelled    StockTransfer[]     @relation("TransferCancelledBy")
  transfersAcknowledged StockTransfer[]     @relation("TransferAcknowledgedBy")
  deliveriesRecorded    Delivery[]
  dealersOnboarded      SuperDealer[]
  productsCreated       Product[]           @relation("ProductCreatedBy")
  productsUpdated       Product[]           @relation("ProductUpdatedBy")

  @@map("users")
}

// How a user signs in. One row per method: "password" (providerAccountId is
// the user id) or an OAuth provider such as "google" (their account id).
model AuthAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  // scrypt hash, only for the "password" provider.
  passwordHash      String?  @map("password_hash")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

// A signed-in browser. The cookie holds a random token; only its SHA-256
// hash is stored, so a leaked table can't be used to sign in.
model Session {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash            String   @unique @map("token_hash")
  userId               String   @map("user_id") @db.Uuid
  // The organization the user is working in; every tenant query scopes to it.
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  expiresAt            DateTime @map("expires_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("sessions")
}

enum VerificationPurpose {
  verify_email
  reset_password
  magic_link

  @@map("verification_purpose")
}

// Single-use tokens sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose    VerificationPurpose
  email      String              @db.Citext
  userId     String?             @map("user_id") @db.Uuid
  tokenHash  String              @unique @map("token_hash")
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  // Unique among live organizations, ignoring case: "Acme" and "acme" clash.
  name        String    @db.Citext
  logoUrl     String?   @map("logo_url")
  // The workspace every user gets at sign-up; it has a single member.
  isPersonal  Boolean   @default(false) @map("is_personal")
  settings    Json      @default("{}")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  roles          Role[]
  memberships    Membership[]
  invitations    Invitation[]
  sessions       Session[]
  products       Product[]
  superDealers   SuperDealer[]
  warehouses     Warehouse[]
  salespeople    Salesperson[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  stockReceipts  StockReceipt[]
  stockTransfers StockTransfer[]
  deliveries     Delivery[]
  zones          Zone[]
  regions        Region[]
  districts      District[]

  @@unique([name], map: "organizations_name_key", where: raw("deleted_at IS NULL"))
  @@map("organizations")
}

// What a role may do, as dotted keys: "members.invite", "billing.manage".
// Features you build add their own keys ("projects.create") in a migration.
model Permission {
  key         String  @id
  description String?

  roles RolePermission[]

  @@map("permissions")
}

// The one system role, owner, has no organization and is shared by all: it
// can do everything and goes to whoever creates the organization. Every other
// role is the organization's own. A migration adding permission keys grants
// them to owner.
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]

  @@unique([organizationId, key])
  // NULLs are distinct in the unique above, so system role keys need their own.
  @@unique([key], map: "roles_system_key_key", where: raw("organization_id IS NULL"))
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

enum MembershipStatus {
  // Added with an invitation that hasn't been accepted yet: they can't sign in
  // to the organization, but already show on Members (and Salespeople).
  invited
  active
  suspended

  @@map("membership_status")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(active)
  // Their name and email are the user's; the phone is how this organization reaches them.
  phone          String?
  invitedById    String?          @map("invited_by_id") @db.Uuid
  // When they were added; set again when an invited member accepts.
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  salesperson  Salesperson?
  // NoAction, not Restrict: checked at the end of the statement, so deleting an
  // organization can cascade through its custom roles and memberships together.
  role         Role         @relation(fields: [roleId], references: [id], onDelete: NoAction)
  invitedBy    User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  // Whose link it is. Their user and invited membership exist from the start,
  // holding the name, phone and role; accepting it sets a password and makes
  // the membership active.
  email          String           @db.Citext
  // SHA-256 of the token in the invite link; the token itself is never stored.
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  // At most one open invitation per address per organization.
  @@unique([organizationId, email], map: "invitations_pending_email_key", where: raw("status = 'pending'"))
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

// What the organization stocks. Prices are whole amounts in the
// organization's currency. Stock on hand is not stored here: it is the sum of
// the product's stock movements.
model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // Generated from the name when the product is added, e.g. "SUNFLOWER-OIL";
  // unique among the organization's products, ignoring case.
  code           String    @db.Citext
  name           String
  // Kept for later; not shown or edited in the app yet.
  description    String?
  // Pack size as written on the product: "1L", "500g", "24 x 330ml".
  size           String?
  sellingPrice   Int       @default(0) @map("selling_price")
  // Archived products keep their history but can't be received or issued.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?           @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  deliveryLines  DeliveryLine[]

  @@unique([organizationId, code])
  @@map("products")
}

// The shops and distributors stock is issued to: where it leaves the store.
// Every field is optional, but a dealer needs a shop name or a contact name,
// and a phone or an email (checked in the database too). Dealers don't sign
// in: a salesperson onboards them in person and they sign on the salesperson's
// screen.
model SuperDealer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  // Unique among the organization's dealers, ignoring case.
  shopName        String?   @map("shop_name") @db.Citext
  contactName     String?   @map("contact_name")
  // Stored as +255754123456; see lib/dealers.ts.
  phone           String?
  email           String?   @db.Citext
  // Where they are; the region and zone come from the district.
  districtId      String?   @map("district_id") @db.Uuid
  // Street, area or landmark within the district.
  address         String?
  // Where the shop is, from the salesperson's phone when onboarding.
  latitude        Float?    @db.DoublePrecision
  longitude       Float?    @db.DoublePrecision
  // Taxpayer Identification Number from TRA, stored as 123-456-789.
  tin             String?
  // Business licence number as printed on the licence.
  businessLicence String?   @map("business_licence")
  notes           String?
  // The dealer's signature as a PNG, the name they signed under and when.
  // All three or none.
  signature       Bytes?
  signedByName    String?   @map("signed_by_name")
  signedAt        DateTime? @map("signed_at") @db.Timestamptz
  // Who onboarded the dealer in the field; empty for dealers added in the office.
  onboardedById   String?   @map("onboarded_by_id") @db.Uuid
  // Inactive dealers keep their history but can't be issued stock.
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboardedBy    User?           @relation(fields: [onboardedById], references: [id], onDelete: SetNull)
  // Places are the organization's own, so the keys pair with organizationId.
  district       District?       @relation(fields: [districtId], references: [id], onDelete: NoAction)
  stockMovements StockMovement[]
  deliveries     Delivery[]

  @@unique([organizationId, shopName])
  @@index([districtId])
  @@map("super_dealers")
}

// Where the organization keeps its stock: the sum of the ledger rows it holds.
model Warehouse {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // Unique among the organization's warehouses, ignoring case.
  name           String    @db.Citext
  // Where it is; the region and zone come from the district.
  districtId     String?   @map("district_id") @db.Uuid
  // Street, area or landmark within the district.
  address        String?
  // The storekeeper or manager to call.
  contactName    String?   @map("contact_name")
  // Stored as +255754123456; see lib/dealers.ts.
  phone          String?
  // Inactive warehouses are kept for the record but hidden from the main list.
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Places are the organization's own, so the keys pair with organizationId.
  district       District?       @relation(fields: [districtId], references: [id], onDelete: NoAction)
  stockMovements StockMovement[]
  stockReceipts  StockReceipt[]
  stockTransfers StockTransfer[]

  @@unique([organizationId, name])
  @@index([districtId])
  @@map("warehouses")
}

enum StockMovementType {
  // In from a supplier, to a warehouse.
  received
  // Warehouse straight to a super dealer.
  issued
  // A correction after a count, damage or loss; either direction.
  adjustment
  // Cancels an earlier movement with the opposite quantity.
  reversal
  // Out of a warehouse to a salesperson, as part of a stock transfer.
  transferred

  @@map("stock_movement_type")
}

// Whose stock a ledger row counts toward. The matching id is always set:
// warehouseId or superDealerId. What a salesperson holds comes from their
// transfers and deliveries (lib/deliveries.ts).
enum StockHolder {
  warehouse
  super_dealer

  @@map("stock_holder")
}

// The stock ledger. Rows are never edited or deleted: a mistake is undone by
// a reversal row, so the history always explains the current balance.
//
// Each row changes one holder's balance; a holder's stock is the sum of its
// rows. Issuing stock writes two rows sharing a moveId, -N from the warehouse
// and +N to the dealer. A transfer's rows take stock out of the warehouse;
// from there the transfer and its deliveries account for it.
model StockMovement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  type           StockMovementType
  holder         StockHolder
  // Signed: positive adds to the holder's stock, negative removes it.
  quantity       Int
  // Cost per unit paid to the supplier, for received stock.
  unitCost       Int?              @map("unit_cost")
  warehouseId    String?           @map("warehouse_id") @db.Uuid
  superDealerId  String?           @map("super_dealer_id") @db.Uuid
  // The two rows of one move: an issue's warehouse and dealer sides.
  moveId         String?           @map("move_id") @db.Uuid
  // The transfer a transferred movement (or its reversal) belongs to.
  transferId     String?           @map("transfer_id") @db.Uuid
  receiptId      String?           @map("receipt_id") @db.Uuid
  // Issue or transfer reference; receipts keep theirs on the receipt.
  reference      String?
  note           String?
  // The day it happened, which may be before it was recorded.
  occurredOn     DateTime          @map("occurred_on") @db.Date
  // The movement this one reverses; each can be reversed once.
  reversesId     String?           @unique @map("reverses_id") @db.Uuid
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // NoAction, not Restrict: deleting an organization cascades through its
  // dealers, warehouses, documents and movements together (see Membership.role).
  warehouse    Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: NoAction)
  superDealer  SuperDealer?   @relation(fields: [superDealerId], references: [id], onDelete: NoAction)
  receipt      StockReceipt?  @relation(fields: [receiptId], references: [id], onDelete: NoAction)
  transfer     StockTransfer? @relation(fields: [transferId], references: [id], onDelete: NoAction)
  reverses     StockMovement? @relation("StockReversal", fields: [reversesId], references: [id], onDelete: NoAction)
  reversedBy   StockMovement? @relation("StockReversal")
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredOn])
  // Movement history: one holder's rows, newest first.
  @@index([organizationId, holder, createdAt(sort: Desc), id(sort: Desc)])
  @@index([productId])
  @@index([warehouseId])
  @@index([superDealerId])
  @@index([transferId])
  @@index([moveId])
  @@index([receiptId])
  @@map("stock_movements")
}

// A delivery from a supplier into a warehouse. Its received ledger rows are
// its lines: product, quantity and unit cost.
model StockReceipt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  // Delivery note or invoice number.
  reference      String?
  note           String?
  // The day it arrived, which may be before it was recorded.
  receivedOn     DateTime @map("received_on") @db.Date
  // The storekeeper who confirmed it.
  receivedById   String?  @map("received_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: NoAction)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  receivedBy     User?           @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@index([organizationId, receivedOn])
  @@index([warehouseId])
  @@index([supplierId])
  @@map("stock_receipts")
}

// Who stock is received from. Every organization has "Manufactured" (see
// lib/suppliers.ts); a receipt recorded without a supplier is filed under it.
model Supplier {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // Unique in the organization, ignoring case: "Acme" and "acme" clash.
  name           String   @db.Citext
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockReceipts StockReceipt[]

  @@unique([organizationId, name])
  @@map("suppliers")
}

// The field staff stock is sent to. Linked to a member's login, they
// acknowledge the stock they receive and record what they supply to dealers.
model Salesperson {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // The member they are: their name and email are the user's, their phone
  // the membership's. Invited members are salespeople before they join.
  membershipId   String    @unique @map("membership_id") @db.Uuid
  // What they cover, stored as the smallest place picked: a district, else a
  // region, else a zone. At most one is set (a check constraint says so); the
  // larger places follow from it.
  zoneKey        String?   @map("zone_key")
  regionKey      String?   @map("region_key")
  districtId     String?   @map("district_id") @db.Uuid
  notes          String?
  // Inactive salespeople keep their history but can't be sent stock.
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Places are the organization's own, so the key pairs with organizationId.
  zone         Zone?           @relation(fields: [organizationId, zoneKey], references: [organizationId, key], onDelete: NoAction)
  region       Region?         @relation(fields: [organizationId, regionKey], references: [organizationId, key], onDelete: NoAction)
  district     District?       @relation(fields: [districtId], references: [id], onDelete: NoAction)
  // Restrict: a member who is a salesperson with history can't be removed.
  membership   Membership      @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  transfers    StockTransfer[]
  deliveries   Delivery[]

  @@index([organizationId, zoneKey])
  @@index([organizationId, regionKey])
  @@index([districtId])
  @@map("salespeople")
}

enum StockTransferStatus {
  // Picked and taken off stock on hand; not yet left the store.
  initiated
  // On its way to the salesperson.
  in_transit
  // The salesperson has it.
  arrived
  // Called off before it left; its stock went back on hand.
  cancelled

  @@map("stock_transfer_status")
}

// Stock sent from a warehouse to a salesperson. Its products are its
// "transferred" stock movements out of that warehouse, made when it is
// initiated, so stock on hand drops straight away. Cancelling reverses them.
model StockTransfer {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  // 1, 2, 3… per organization, shown as TR-0001.
  number           Int
  salespersonId    String              @map("salesperson_id") @db.Uuid
  warehouseId      String              @map("warehouse_id") @db.Uuid
  status           StockTransferStatus @default(initiated)
  // Dispatch note or vehicle number.
  reference        String?
  note             String?
  // The day the stock was taken off the shelf.
  initiatedOn      DateTime            @map("initiated_on") @db.Date
  createdById      String?             @map("created_by_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt     DateTime?           @map("dispatched_at") @db.Timestamptz
  dispatchedById   String?             @map("dispatched_by_id") @db.Uuid
  arrivedAt        DateTime?           @map("arrived_at") @db.Timestamptz
  arrivedById      String?             @map("arrived_by_id") @db.Uuid
  cancelledAt      DateTime?           @map("cancelled_at") @db.Timestamptz
  cancelledById    String?             @map("cancelled_by_id") @db.Uuid
  // The salesperson confirmed they have it; only then can they supply it.
  acknowledgedAt   DateTime?           @map("acknowledged_at") @db.Timestamptz
  acknowledgedById String?             @map("acknowledged_by_id") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // NoAction like StockMovement.superDealer: salespeople are deactivated, not deleted.
  salesperson    Salesperson     @relation(fields: [salespersonId], references: [id], onDelete: NoAction)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: NoAction)
  createdBy      User?           @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchedBy   User?           @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  arrivedBy      User?           @relation("TransferArrivedBy", fields: [arrivedById], references: [id], onDelete: SetNull)
  cancelledBy    User?           @relation("TransferCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  acknowledgedBy User?           @relation("TransferAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  movements      StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([salespersonId])
  @@index([warehouseId])
  @@map("stock_transfers")
}

// ---------------------------------------------------------------------------
// Places (per organization)
// ---------------------------------------------------------------------------

// Each organization's sales zones, regions and districts, so dealers pick a
// place from a list instead of typing it. A new organization can start from
// Tanzania's (lib/tanzania-places.ts). Keys are slugs of the names, unique
// within the organization: "coastal", "dar-es-salaam", "kinondoni".
model Zone {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  name           String
  // Order in lists, roughly coast first and Zanzibar last.
  position       Int    @db.SmallInt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regions      Region[]
  salespeople  Salesperson[]

  @@id([organizationId, key])
  @@map("zones")
}

model Region {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  zoneKey        String @map("zone_key")
  name           String

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone         Zone          @relation(fields: [organizationId, zoneKey], references: [organizationId, key], onDelete: NoAction)
  districts    District[]
  salespeople  Salesperson[]

  @@id([organizationId, key])
  @@index([organizationId, zoneKey])
  @@map("regions")
}

// Unique within its region only.
model District {
  // What warehouses and dealers point at; the keys below are for the place pickers.
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  regionKey      String @map("region_key")
  key            String
  name           String

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  region       Region        @relation(fields: [organizationId, regionKey], references: [organizationId, key], onDelete: NoAction)
  superDealers SuperDealer[]
  warehouses   Warehouse[]
  salespeople  Salesperson[]

  @@unique([organizationId, regionKey, key])
  @@map("districts")
}

// ---------------------------------------------------------------------------
// Rate limits
// ---------------------------------------------------------------------------

// Fixed-window counters for lib/rate-limit.ts, one row per key, e.g.
// "login:ip:203.0.113.7". Expired rows are deleted by lib/cleanup.ts.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz

  @@index([resetAt])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Deliveries
// ---------------------------------------------------------------------------

// Stock a salesperson supplies to a super dealer from what they hold. What a
// salesperson holds is the stock of their acknowledged transfers less their
// deliveries, so it isn't stored either. The store's stock ledger is not
// touched: that stock left the store with the transfer.
model Delivery {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // 1, 2, 3… per organization, shown as DL-0001.
  number         Int
  salespersonId  String   @map("salesperson_id") @db.Uuid
  superDealerId  String   @map("super_dealer_id") @db.Uuid
  // The day the dealer got it, which may be before it was recorded.
  deliveredOn    DateTime @map("delivered_on") @db.Date
  // Delivery note or receipt number.
  reference      String?
  note           String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // NoAction: salespeople and dealers are deactivated, not deleted.
  salesperson  Salesperson    @relation(fields: [salespersonId], references: [id], onDelete: NoAction)
  superDealer  SuperDealer    @relation(fields: [superDealerId], references: [id], onDelete: NoAction)
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines        DeliveryLine[]

  @@unique([organizationId, number])
  // The deliveries list, newest first: everyone's, or one salesperson's.
  @@index([organizationId, deliveredOn(sort: Desc), number(sort: Desc)])
  @@index([salespersonId, deliveredOn(sort: Desc), number(sort: Desc)])
  @@index([superDealerId])
  @@map("deliveries")
}

model DeliveryLine {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String @map("delivery_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  // Units handed over; always positive.
  quantity   Int

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@unique([deliveryId, productId])
  @@index([productId])
  @@map("delivery_lines")
}
